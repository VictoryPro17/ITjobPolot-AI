{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=jobpilot;Username=jobpilot;Password=jobpilot_dev"
  },
  "App": {
    "CorsOrigins": [ "http://localhost:5173" ]
  },
  "Storage": {
    "UploadRoot": "uploads",
    "MaxFileSizeInBytes": 10485760,
    "AllowedContentTypes": [
      "application/pdf",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "text/plain",
      "text/markdown",
      "image/png",
      "image/jpeg"
    ],
    "AllowedExtensions": [ ".pdf", ".docx", ".txt", ".md", ".png", ".jpg", ".jpeg" ],
    "MaxDocumentsPerUser": 100
  },
  "Ai": {
    "Enabled": false,
    "Provider": "openai",
    "Model": "gpt-4o-mini",
    "BaseUrl": "http://localhost:11434",
    "TimeoutSeconds": 120,
    "DailyRequestLimitPerUser": 25
  },
  "AllowedHosts": "*"
}
