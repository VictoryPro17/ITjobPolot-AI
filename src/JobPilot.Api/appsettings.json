{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=jobpilot;Username=jobpilot;Password=jobpilot_dev"
  },
  "App": {
    "CorsOrigins": [ "http://localhost:5173" ]
  },
  "Storage": {
    "UploadRoot": "uploads",
    "MaxFileSizeInBytes": 10485760,
    "AllowedContentTypes": [ "application/pdf" ],
    "AllowedExtensions": [ ".pdf" ]
  },
  "Ai": {
    "Enabled": true,
    "Provider": "openai",
    "Model": "gpt-4o-mini",
    "DailyRequestLimitPerUser": 25
  },
  "AllowedHosts": "*"
}
